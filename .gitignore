# ==============================
# FERA 2.0 - Git Ignore
# ==============================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Environment variables / secrets
.env
.env.*
!.env.example

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE / editor
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Node / frontend
node_modules/
dist/
build/
.npm/
.pnpm-store/

# Frontend environment files
frontend/.env
frontend/.env.*
!frontend/.env.example

# Generated data
ml/datasets/raw/
ml/datasets/processed/
ml/experiments/runs/

# Model artifacts generated locally
models/*.joblib
models/*.pkl
models/*.onnx

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp

# Local databases
*.db
*.sqlite
*.sqlite3

# Test artifacts
.pytest_cache/
test-results/
playwright-report/

# Build artifacts
*.egg-info/
dist/
# Local FERA 1.0 audit copy
fera-1.0-source/

# FERA datasets
data/raw/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# FERA 2.0 trained model artifacts
!data/models/
!data/models/*.pkl
